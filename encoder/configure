#!/bin/sh
set -e

# apply local patches to vendored submodules (idempotent: skipped when already applied)
for patch in patches/gifsicle-*.patch; do
  if git -c safe.directory="*" -C vendor/gifsicle apply --reverse --check "../../$patch" 2>/dev/null; then
    echo "already applied: $patch"
  else
    git -c safe.directory="*" -C vendor/gifsicle apply "../../$patch"
  fi
done

(cd vendor/libimagequant && ./configure --disable-sse CC=emcc)
(cd vendor/gifsicle && autoreconf -i && ./configure --disable-gifview --disable-gifdiff --disable-simd --disable-threads CC=emcc)
